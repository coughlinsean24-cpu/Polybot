# Polybot Environment Variables
# âš ï¸  DO NOT COMMIT THIS FILE â€” it contains secrets


# Required for LIVE trading only (not needed for paper trading)
POLYMARKET_API_KEY=your-api-key-here
POLYMARKET_API_SECRET=your-api-secret-here
POLYMARKET_PASSPHRASE=your-passphrase-here


# Your Polygon wallet private key (needed to sign transactions)
POLYMARKET_PRIVATE_KEY=0xYourPrivateKeyHere


# Set to "false" to pause trading without stopping the bot
TRADING_ENABLED=true
